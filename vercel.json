{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(img|frames)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/manuten%C3%A7%C3%A3o",
      "destination": "/manutencao",
      "permanent": true
    },
    {
      "source": "/manutenção",
      "destination": "/manutencao",
      "permanent": true
    },
    {
      "source": "/conserto",
      "destination": "/manutencao",
      "permanent": false
    },
    {
      "source": "/kommo",
      "destination": "/kommo/entrar",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/kommo/entrar",
      "destination": "https://organizador-kommo.vercel.app/entrar"
    },
    {
      "source": "/kommo/painel",
      "destination": "https://organizador-kommo.vercel.app/painel"
    },
    {
      "source": "/kommo/api/:caminho*",
      "destination": "https://organizador-kommo.vercel.app/api/:caminho*"
    }
  ]
}
